terraform {
  required_version = ">= 1.5.0"
  required_providers {
    local = {
      source  = "hashicorp/local"
      version = "~> 2.4"
    }
  }
}

# 1. Read the JSON generated by python-engine
data "local_file" "scaling_decision" {
  filename = "${path.module}/../python-engine/scaling_decision.json"
}

# 2. Parse the JSON payload into HCL objects
locals {
  decision_data    = jsondecode(data.local_file.scaling_decision.content)
  action           = local.decision_data.action
  predicted_cpu    = local.decision_data.predicted_cpu
  desired_capacity = local.decision_data.desired_capacity
}

# 3. Simulated Infrastructure State (mocking an AWS ASG or EKS Node Group)
resource "local_file" "cluster_state" {
  filename = "${path.module}/cluster_state.txt"
  content  = <<-EOT
    ==============================
    CLUSTER AUTOSCALING STATUS
    ==============================
    Action Triggered : ${local.action}
    Predicted CPU    : ${local.predicted_cpu}%
    Desired Nodes    : ${local.desired_capacity}
    Applied At       : ${timestamp()}
  EOT
}

# 4. Expose output values to terminal
output "action_taken" {
  value = local.action
}

output "applied_node_count" {
  value = local.desired_capacity
}